{
  "name": "prepare-gibraltar",
  "version": "1.0.0",
  "description": "Prepare Gibraltar — Civil Contingencies emergency preparedness site",
  "type": "module",
  "scripts": {
    "start": "eleventy --serve",
    "build": "npm run check && rm -rf _site && eleventy",
    "check": "node check-contacts.mjs",
    "test": "node --test contact-scan.test.mjs",
    "review": "npm run build && node review.mjs",
    "test:auth": "node cms-auth/test.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "accessibility-checker": "^4.0.31",
    "decap-cms": "^3.10.1",
    "puppeteer": "^25.11.0",
    "wrangler": "^4.131.2"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
