---
layout: layouts/page.njk
---
{#
  The hazards index: editable intro and alert above a grid built from the
  hazard pages themselves. The cards are not editable here and should not be —
  their titles, summaries and thumbnails come from each hazard's own frontmatter,
  so there is one place to change a hazard's name.

  Frontmatter this reads:
    intro      plain text, rendered as p.section__intro
    alertTop   { variant, heading?, body }
#}
{%- if intro %}
<p class="section__intro">{{ intro }}</p>
{%- endif %}
{%- if alertTop %}

{% set box = alertTop %}{% include "alert-box.njk" %}
{%- endif %}

<div class="hazards-grid">
  {% for hazard in collections.hazards %}
  <article class="hazard-card">
    {% if hazard.data.thumbnail %}
    <div class="hazard-card__image">
      <img src="{{ hazard.data.thumbnail }}" alt="{{ hazard.data.title }}" loading="lazy" {% if hazard.data.thumbnail_position %}style="object-position: {{ hazard.data.thumbnail_position }}"{% endif %}>
    </div>
    {% endif %}
    <div class="hazard-card__body">
      {# One link per card. The stylesheet stretches it over the photograph, the
         summary and the padding, so the whole card is the click target and a
         screen reader hears a single link named after the hazard. #}
      <h2 class="hazard-card__title"><a class="hazard-card__link" href="{{ hazard.url }}">{{ hazard.data.title }}</a></h2>
      <p class="hazard-card__summary">{{ hazard.data.summary }}</p>
      <span class="hazard-card__cta" aria-hidden="true">Read guidance →</span>
    </div>
  </article>
  {% endfor %}
</div>
