---
layout: layouts/base.njk
title: Home
hideEmergencyStrip: true
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero__inner">
      <p class="hero__kicker">
        <img src="/assets/images/hmgog-logo.png" alt="HM Government of Gibraltar" width="150" height="150" class="hero__kicker-logo">
      </p>
      <h1 class="hero__title" id="hero-heading">{{ homepage.heroHeadline if homepage.heroHeadline else "Prepare Gibraltar" }}</h1>
      <p class="hero__description">{{ homepage.heroSubheadline if homepage.heroSubheadline else site.tagline }}</p>
      <p class="hero__body">Emergencies such as flooding, wildfires and power cuts can happen without warning in Gibraltar. Taking a few simple steps now means you and your family will be better prepared when it matters most.</p>
      <div class="hero__actions">
        <a href="/get-prepared/" class="btn btn--white">Get Prepared Now</a>
        <a href="/emergency-contacts/" class="btn btn--outline">Emergency Contacts</a>
      </div>
    </div>
  </div>
</section>

