---
layout: layouts/base.njk
title: Home
hideEmergencyStrip: true
---
{#
  The homepage. Its words live in src/_data/homepage.json and its contact rows in
  src/_data/contacts.json; what remains here is markup. Each section is bespoke —
  this is the one page that does not use layouts/page.njk and has no breadcrumb.
#}
<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero__inner">
      <p class="hero__kicker">
        <img src="/assets/images/hmgog-logo.png" alt="HM Government of Gibraltar" width="150" height="150" class="hero__kicker-logo">
      </p>
      <h1 class="hero__title" id="hero-heading">{{ homepage.heroHeadline if homepage.heroHeadline else "Prepare Gibraltar" }}</h1>
      <p class="hero__description">{{ homepage.heroSubheadline if homepage.heroSubheadline else site.tagline }}</p>
      <p class="hero__body">{{ homepage.heroBody }}</p>
      <div class="hero__actions">
        {%- for action in homepage.heroActions %}
        <a href="{{ action.url }}" class="btn {{ action.style }}">{{ action.label }}</a>
        {%- endfor %}
      </div>
    </div>
  </div>
</section>

<section class="emergency-disclaimer" aria-label="Emergency information notice">
  <div class="container">
    <div class="emergency-disclaimer__icon" aria-hidden="true">⚠</div>
    <div>
      <p>{{ homepage.disclaimerLead | markdownifyInline | safe }}</p>
      <p>{{ homepage.disclaimerChannelsIntro }}</p>
      {% set channelsStyle = "margin-top:var(--space-sm)" %}{% include "whatsapp-channels.njk" %}
    </div>
  </div>
</section>

<section class="pillars" aria-labelledby="pillars-heading">
  <div class="container">
    <h2 class="pillars__heading" id="pillars-heading">{{ homepage.pillarsHeading }}</h2>
    <div class="pillars__grid">
      {%- for pillar in homepage.pillars %}

      <article class="pillar-card" style="--card-image: url('{{ pillar.image }}')" aria-labelledby="{{ pillar.id }}">
        <div class="pillar-card__content">
          <h3 class="pillar-card__title" id="{{ pillar.id }}">{{ pillar.title }}</h3>
          <p class="pillar-card__description">{{ pillar.description }}</p>
          <a class="pillar-card__link" href="{{ pillar.url }}">{{ pillar.linkLabel }}</a>
        </div>
      </article>
      {%- endfor %}

    </div>
  </div>
</section>

<section class="quick-actions section section--surface" aria-labelledby="actions-heading">
  <div class="container">
    <h2 id="actions-heading">{{ homepage.stepsHeading }}</h2>
    <p class="section__intro">{{ homepage.stepsIntro }}</p>
    <ol class="quick-actions__list">
      {%- for step in homepage.steps %}
      {%- if step.showChannels %}
      <li class="quick-actions__item">
        <div>
          <p>{{ step.text }}</p>
          {% set channelsStyle = false %}{% include "whatsapp-channels.njk" %}
        </div>
      </li>
      {%- else %}
      <li class="quick-actions__item">{{ step.text }}</li>
      {%- endif %}
      {%- endfor %}
    </ol>
    <p style="margin-top:1.5rem"><a href="{{ homepage.stepsButtonUrl }}" class="btn btn--primary">{{ homepage.stepsButtonLabel }}</a></p>
  </div>
</section>

<section class="section" aria-labelledby="contacts-teaser-heading">
  <div class="container">
    <h2 id="contacts-teaser-heading">{{ homepage.contactsHeading }}</h2>
    <p class="section__intro">{{ homepage.contactsIntro }}</p>
    <div class="emergency-number-block">
      <span class="emergency-number-block__label">{{ homepage.emergencyBlockLabel }}</span>
      <a href="tel:{{ homepage.emergencyBlockNumber }}" class="emergency-number-block__number">{{ homepage.emergencyBlockNumber }}</a>
      <span class="emergency-number-block__sub">{{ homepage.emergencyBlockSub }}</span>
    </div>
    <table class="contacts-table" style="max-width:600px;margin-top:var(--space-lg)">
      <tbody>
        {#- The rows flagged homepage: true in src/_data/contacts.json. Same source
            as the full contacts page, so a number cannot be right on one and
            wrong on the other. #}
        {%- for group in contacts.groups %}{% for row in group.rows %}{% if row.homepage %}
        <tr>
          <th scope="row">{{ row.service }}</th>
          <td{% if row.number %} class="contact-number"{% endif %}>
            {%- if row.number %}<a href="tel:{{ row.number | replace(" ", "") }}">{{ row.number }}</a>{% endif %}
            {%- if row.detail %}{{ row.detail | markdownifyInline | safe }}{% endif %}</td>
        </tr>
        {%- endif %}{% endfor %}{% endfor %}
      </tbody>
    </table>
    <p style="margin-top:1.5rem"><a href="{{ homepage.contactsLinkUrl }}">{{ homepage.contactsLinkLabel }}</a></p>
  </div>
</section>
